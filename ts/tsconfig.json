{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2022"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "skipLibCheck": true
  },
  "include": [
    "lmcc/**/*.ts",
    "lmccstd/**/*.ts",
    "conform/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ]
}