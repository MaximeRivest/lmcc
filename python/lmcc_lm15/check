#!/usr/bin/env bash
# The lm15 bridge's gate: lmcc_lm15 against a real lm15, offline.
# The pin is an exact lm15 release (pyproject extra `lm15`), read from pyproject.
# Builds python/.venv-lm15 with uv, again whenever the pin changes;
# fails loudly if lm15 cannot be imported — never skips.
# Local development against a checkout: uv pip install -e ~/Projects/lm15-dev/lm15-python --python .venv-lm15/bin/python
set -euo pipefail
cd "$(dirname "$0")/.."
VENV=.venv-lm15
LM15_PIN=$(grep -o '"lm15[=@][^"]*"' pyproject.toml | tr -d '"')
if command -v uv >/dev/null 2>&1; then UV=uv; else UV="nix run nixpkgs#uv --"; fi
if [ ! -x "$VENV/bin/python" ] || [ "$(cat "$VENV/.lm15-pin" 2>/dev/null)" != "$LM15_PIN" ]; then
  echo "building $VENV ($LM15_PIN + pytest) ..."
  [ -x "$VENV/bin/python" ] || $UV venv -q "$VENV" --python 3.12
  $UV pip install -q --python "$VENV/bin/python" "$LM15_PIN" pytest
  echo "$LM15_PIN" > "$VENV/.lm15-pin"
fi
"$VENV/bin/python" -c 'import lm15; print("lm15", lm15.__version__)'
PYTHONPATH=. "$VENV/bin/python" -m pytest -q tests/lm15
