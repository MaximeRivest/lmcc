#!/usr/bin/env bash
# The one command. Green here = the contract holds.
# 1) unit + corpus tests (Python)   2) conformance harness, Python reference
# 3) schema validation (entries, signatures, cases)
# 4) README quickstart runs verbatim (GUIDE and the howtos run in step 1)
# 5) the DSPy frontend catalog against a real DSPy (venv built on first run)
# 6) the lm15 bridge against a real lm15 at the pinned commit
# Python is the one implementation. Another language joins by passing the
# same corpus through the harness: runner.py --driver CMD (kernel §9).
set -euo pipefail
cd "$(dirname "$0")"

step() { printf '\n== %s ==\n' "$1"; }

run_py() {  # run python with repo layout on the path
  (cd python && PYTHONPATH=. python "$@")
}

step "1/6 unit + corpus tests (python)"
if pytest --version >/dev/null 2>&1; then
  (cd python && PYTHONPATH=. pytest -q tests/)
elif python -c 'import pytest' 2>/dev/null; then
  (cd python && PYTHONPATH=. python -m pytest -q tests/)
else
  (cd python && PYTHONPATH=. nix run nixpkgs#python3Packages.pytest -- -q tests/)
fi

step "2/6 conformance harness, python reference (corpus is the authority)"
run_py ../contract/harness/runner.py

step "3/6 schema validation (entries, signatures, cases)"
VALIDATE='
import json, glob, jsonschema
entry = json.load(open("contract/schema/entry.schema.json"))
signature = json.load(open("contract/schema/signature.schema.json"))
case_schema = json.load(open("contract/schema/case.schema.json"))
fix_schema = json.load(open("contract/schema/fix.schema.json"))
turn_schema = json.load(open("contract/schema/turn.schema.json"))
from referencing import Registry, Resource
schemas = Registry().with_resource(turn_schema["$id"], Resource.from_contents(turn_schema))
case_validator = jsonschema.Draft202012Validator(case_schema, registry=schemas)
n = 0
for f in sorted(glob.glob("contract/corpus/cases/*.json")):
    case = json.load(open(f))
    case_validator.validate(case)
    if "fix" in case.get("expect", {}):
        jsonschema.validate(case["expect"]["fix"], fix_schema)
    try:
        jsonschema.validate(case["entry"], entry)
    except jsonschema.ValidationError:
        # Only authored malformed-entry load refusals may violate the entry
        # schema. The case and its refusal/fix still validate normally.
        if not (case["kind"] == "refuse" and case["expect"].get("at") == "load"
                and case["expect"].get("code") == "entry-malformed"):
            raise
    if "entry" in case.get("expect", {}):
        jsonschema.validate(case["expect"]["entry"], entry)
    if "signature" in case and case["expect"].get("code") != "signature-malformed":
        jsonschema.validate(case["signature"], signature)
    n += 1
print(n, "cases validate against the case, turn, entry, signature and fix schemas")
'
if python -c 'import jsonschema' 2>/dev/null; then
  python -c "$VALIDATE"
else
  nix shell --impure --expr \
    'with import <nixpkgs> {}; python3.withPackages (p: [ p.jsonschema ])' \
    -c python3 -c "$VALIDATE"
fi

step "4/6 README quickstart, verbatim"
run_py - <<'EOF'
import re, pathlib
text = pathlib.Path('../README.md').read_text()
code = '\n'.join(re.findall(r'```python\n(.*?)```', text, re.DOTALL))
exec(compile(code, 'README-quickstart', 'exec'))
print('README quickstart runs verbatim')
EOF

step "5/6 dspy frontend: feature catalog against a real DSPy"
python/lmcc_dspy/check

step "6/6 lm15 bridge: typed requests, responses and streams against a real lm15 (pinned release)"
python/lmcc_lm15/check

printf '\nALL GREEN\n'
