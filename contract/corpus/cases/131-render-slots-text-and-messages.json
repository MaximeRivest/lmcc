{
 "name": "render-slots-text-and-messages",
 "kind": "render",
 "entry": {
  "name": "sections_v1",
  "versions": {
   "kernel": "0.7.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\n{% if examples %}Examples:\n{% for m in examples %}[{m.kind}] {m.text}\n{% endfor %}\n{% endif %}Reply with EXACTLY these sections:\n{% for f in outputs %}<{f.name}>\n{f.value}\n{% endfor %}</done>"
   },
   {
    "directive": "turns",
    "slot": "conversation"
   },
   {
    "role": "user",
    "text": "{% for f in inputs %}== {f.name} ==\n{f.value}\n{% endfor %}"
   }
  ],
  "reader": {
   "kind": "derived"
  }
 },
 "signature": {
  "instructions": "Answer the question.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "desc": "short answer"
   },
   {
    "name": "score",
    "direction": "output",
    "shape": {
     "type": "integer"
    }
   }
  ]
 },
 "inputs": {
  "question": "3+3?"
 },
 "turns": {
  "examples": [
   {
    "inputs": {
     "question": "2+2?"
    },
    "outputs": {
     "answer": "4",
     "score": 10
    }
   }
  ],
  "conversation": [
   {
    "inputs": {
     "question": "hi"
    },
    "outputs": {
     "answer": "hello",
     "score": 1
    }
   }
  ]
 },
 "expect": {
  "request": {
   "system": "Answer the question.\n\nExamples:\n[input] == question ==\n2+2?\n\n[model] <answer>\n4\n<score>\n10\n</done>\n\nReply with EXACTLY these sections:\n<answer>\nshort answer\n<score>\n(integer)\n</done>",
   "messages": [
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "== question ==\nhi\n"
      }
     ]
    },
    {
     "role": "assistant",
     "parts": [
      {
       "type": "text",
       "text": "<answer>\nhello\n<score>\n1\n</done>"
      }
     ]
    },
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "== question ==\n3+3?\n"
      }
     ]
    }
   ]
  }
 }
}
