{
 "name": "std-table-format-demo-lens",
 "kind": "render",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "sections_v1",
  "versions": {
   "kernel": "0.2.0",
   "vocab": {
    "format/table": "0.1.0"
   }
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nReply with EXACTLY these sections:\n{% for f in outputs %}<{f.name}>\n{f.value}\n{% endfor %}</done>"
   },
   {
    "directive": "demos"
   },
   {
    "directive": "history"
   },
   {
    "role": "user",
    "text": "{% for f in inputs %}== {f.name} ==\n{f.value}\n{% endfor %}"
   }
  ],
  "parse": {
   "kind": "derived"
  },
  "formats": {
   "list[object]": {
    "use": "table",
    "options": {
     "columns": [
      "name",
      "score"
     ]
    }
   }
  }
 },
 "signature": {
  "instructions": "Rank.",
  "fields": [
   {
    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "rows",
    "direction": "output",
    "shape": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "score": {
        "type": "integer"
       }
      }
     }
    }
   }
  ]
 },
 "inputs": {
  "q": "rank these"
 },
 "demos": [
  {
   "q": "rank those",
   "rows": [
    {
     "name": "a|b",
     "score": 3
    },
    {
     "name": "c",
     "score": 1
    }
   ]
  }
 ],
 "expect": {
  "messages": [
   {
    "role": "system",
    "content": [
     {
      "kind": "text",
      "text": "Rank.\n\nReply with EXACTLY these sections:\n<rows>\n| name | score |  (one row per item)\n</done>"
     }
    ]
   },
   {
    "role": "user",
    "content": [
     {
      "kind": "text",
      "text": "== q ==\nrank those\n"
     }
    ]
   },
   {
    "role": "assistant",
    "content": [
     {
      "kind": "text",
      "text": "<rows>\n| a\\|b | 3 |\n| c | 1 |\n</done>"
     }
    ]
   },
   {
    "role": "user",
    "content": [
     {
      "kind": "text",
      "text": "== q ==\nrank these\n"
     }
    ]
   }
  ],
  "patch": {}
 }
}
