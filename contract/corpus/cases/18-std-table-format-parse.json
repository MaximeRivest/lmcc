{
 "name": "std-table-format-parse",
 "kind": "parse",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "sections_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {
    "format/table": "0.2.0"
   }
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nReply with EXACTLY these sections:\n{% for f in outputs %}<{f.name}>\n{f.value}\n{% endfor %}</done>"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{% for f in inputs %}== {f.name} ==\n{f.value}\n{% endfor %}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "formats": {
   "list[object]": {
    "use": "table",
    "options": {
     "columns": [
      "name",
      "score"
     ]
    }
   }
  }
 },
 "signature": {
  "instructions": "Rank.",
  "fields": [
   {
    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "rows",
    "direction": "output",
    "shape": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "score": {
        "type": "integer"
       }
      }
     }
    }
   }
  ]
 },
 "response": "<rows>\n| name | score |\n| carol | 9 |\n</done>",
 "expect": {
  "values": {
   "rows": [
    {
     "name": "carol",
     "score": 9
    }
   ]
  }
 }
}
