{
 "name": "refuse-json-lens-malformed",
 "kind": "refuse",
 "vocab": ["std"],
 "entry": {
  "name": "json_lens_v1",
  "versions": {
   "kernel": "0.1.0",
   "vocab": {
    "lens/json_object": "0.1.0"
   }
  },
  "template": {
   "messages": [
    {
     "role": "user",
     "text": "{question}"
    }
   ]
  },
  "parse": {
   "kind": "json_object"
  },
  "requires": []
 },
 "signature": {
  "instructions": "Answer.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "response": "The answer is Paris.",
 "expect": {
  "code": "lens-parse-error",
  "at": "parse"
 }
}
