{
 "name": "refuse-json-lens-malformed",
 "kind": "refuse",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "json_lens_v1",
  "versions": {
   "kernel": "0.2.0",
   "vocab": {
    "lens/json_object": "0.1.0"
   }
  },
  "template": [
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "parse": {
   "kind": "json_object"
  }
 },
 "signature": {
  "instructions": "Answer.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "capabilities": {
  "native_structured_output": true
 },
 "response": "The answer is Paris.",
 "expect": {
  "code": "lens-parse-error",
  "at": "parse"
 }
}
