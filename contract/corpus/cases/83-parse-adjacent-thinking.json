{
 "name": "parse-adjacent-thinking",
 "kind": "parse",
 "entry": {
  "name": "choose_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nAnswer in exactly this form:\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "role": "user",
    "text": "{q}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "reasoning": {
    "choose": [
     {
      "when": {
       "capability": "native_reasoning"
      },
      "use": {
       "requires": [
        "native_reasoning"
       ],
       "in_template": false,
       "request_settings": {
        "config": {
         "reasoning": {
          "effort": "medium"
         }
        }
       },
       "find": [
        {
         "from": "part:thinking",
         "to": "@purpose"
        }
       ]
      }
     },
     {
      "else": {
       "in_template": false,
       "tell": {
        "system": "Think inside <think>...</think> before you answer."
       },
       "find": [
        {
         "from": "text",
         "between": [
          "<think>",
          "</think>"
         ],
         "to": "@purpose",
         "remove": true
        }
       ]
      }
     }
    ]
   }
  }
 },
 "signature": {
  "instructions": "Solve.",
  "fields": [
   {
    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "purpose": "reasoning"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "integer"
    }
   }
  ]
 },
 "capabilities": {
  "native_reasoning": true
 },
 "response": {
  "role": "assistant",
  "parts": [
   {
    "type": "thinking",
    "text": "fo"
   },
   {
    "type": "thinking",
    "text": "ur"
   },
   {
    "type": "text",
    "text": "<answer>\n4\n</answer>"
   }
  ]
 },
 "expect": {
  "values": {
   "reasoning": "four",
   "answer": 4
  }
 }
}
