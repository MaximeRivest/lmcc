    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    },
    "desc": "the question"
   },
   {
    "name": "n",
    "direction": "input",
    "shape": {
     "type": "integer"
    },
    "role": "citable"
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "role": "reasoning",
    "desc": "think"
   },
   {
    "name": "score",
    "direction": "output",
    "shape": {
     "type": "number"
    }
   },
   {
    "name": "level",
    "direction": "output",
    "shape": {
     "enum": [
      "low",
      "high"
     ],
     "type": "string"
    }
   },
   {
    "name": "note",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "inputs": {
  "q": "hi",
  "n": 3
 },
