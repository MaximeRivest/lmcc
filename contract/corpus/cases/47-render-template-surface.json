    "role": "system",
    "content": [
     {
      "kind": "text",
      "text": "Do.\nIN q [plain] the question \nIN n [citable]  (integer)\nOUT reasoning [reasoning] think \nOUT score [plain]  (number)\nOUT level [plain]  one of: low, high\nOUT note [plain]  \n{braces}\n[[ ## reasoning ## ]]\nthink\n[[ ## score ## ]]\n(number)\n[[ ## level ## ]]\none of: low, high\n[[ ## note ## ]]\n...\n[[ ## completed ## ]]"
     }
    ]
   },
   {
