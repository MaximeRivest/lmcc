 "entry": {
  "name": "surface_v1",
  "versions": {
   "kernel": "0.2.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in inputs %}IN {f.name} [{f.role}] {f.desc} {f.schema}\n{% endfor %}{% for f in outputs %}OUT {f.name} [{f.role}] {f.desc} {f.schema}\n{% endfor %}{{braces}}\n{% for f in outputs %}[[ ## {f.name} ## ]]\n{f.value}\n{% endfor %}[[ ## completed ## ]]"
   },
   {
    "directive": "history"
   },
   {
    "role": "user",
    "text": "{q} {n}"
   }
  ],
  "parse": {
   "kind": "derived"
  }
 },
 "signature": {
  "instructions": "Do.",
  "fields": [
