{
 "kind": "roundtrip",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "tools_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {
    "format/code_arguments": "0.1.0",
    "format/function_tool": "0.1.0",
    "format/code_calls": "0.1.0"
   }
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "tools": {
    "choose": [
     {
      "else": {
       "requires": [
        "instruct"
       ],
       "in_template": false,
       "put": {
        "@purpose": "message:system"
       },
       "written_as": {
        "@purpose": "tool_catalog"
       },
       "find": [
        {
         "from": "text",
         "between": [
          "run_python <<'PY_END'\n",
          "\nPY_END"
         ],
         "to": "@purpose.calls",
         "remove": true,
         "complete_reply": true
        }
       ],
       "spelling": {
        "call": "{name} <<'PY_END'\n{input}\nPY_END",
        "input_format": {
         "use": "code_arguments"
        },
        "probe": {
         "name": "run_python",
         "input": {
          "code": "print(6 * 7)\n"
         }
        }
       }
      }
     }
    ]
   }
  },
  "formats": {
   "list[Tool]": {
    "use": "function_tool"
   },
   "list[ToolCall]": {
    "use": "code_calls"
   }
  }
 },
