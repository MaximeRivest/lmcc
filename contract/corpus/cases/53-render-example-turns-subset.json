{
 "name": "render-example-turns-subset",
 "kind": "render",
 "entry": {
  "name": "chat_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}[[ ## {f.name} ## ]]\n{f.value}\n{% endfor %}[[ ## completed ## ]]"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{% for f in inputs %}== {f.name} ==\n{f.value}\n{% endfor %}"
   }
  ],
  "reader": {
   "kind": "derived"
  }
 },
 "signature": {
  "instructions": "Chat.",
  "fields": [
   {
    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "hint",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "a",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "score",
    "direction": "output",
    "shape": {
     "type": "integer"
    }
   }
  ]
 },
 "inputs": {
  "q": "third",
  "hint": "h3"
 },
 "turns": {
  "turns": [
   {
    "inputs": {
     "q": "first",
     "hint": "h1"
    },
    "outputs": {
     "a": "one",
     "score": 1
    }
   },
   {
    "inputs": {
     "q": "second"
    },
    "outputs": {
     "a": "two"
    }
   }
  ]
 },
 "expect": {
  "request": {
   "system": "Chat.\n[[ ## a ## ]]\n...\n[[ ## score ## ]]\n(integer)\n[[ ## completed ## ]]",
   "messages": [
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "== q ==\nfirst\n== hint ==\nh1\n"
      }
     ]
    },
    {
     "role": "assistant",
     "parts": [
      {
       "type": "text",
       "text": "[[ ## a ## ]]\none\n[[ ## score ## ]]\n1\n[[ ## completed ## ]]"
      }
     ]
    },
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "== q ==\nsecond\n"
      }
     ]
    },
    {
     "role": "assistant",
     "parts": [
      {
       "type": "text",
       "text": "[[ ## a ## ]]\ntwo\n[[ ## completed ## ]]"
      }
     ]
    },
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "== q ==\nthird\n== hint ==\nh3\n"
      }
     ]
    }
   ]
  }
 }
}
