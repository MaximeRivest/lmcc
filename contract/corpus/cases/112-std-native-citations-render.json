{
 "name": "std-native-citations-render",
 "kind": "render",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "cite_v1",
  "versions": {
   "kernel": "0.5.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "parse": {
   "kind": "derived"
  },
  "strategies": {
   "citations": {
    "use": "native_citations"
   }
  },
  "formats": {
   "list[Citation]": {
    "use": "citations"
   },
   "list[Source]": {
    "use": "source_list"
   }
  }
 },
 "signature": {
  "instructions": "Answer with sources.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "citations",
    "direction": "output",
    "type": "list[Citation]",
    "shape": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "role": "citations"
   }
  ]
 },
 "capabilities": {
  "native_citations": true
 },
 "inputs": {
  "question": "Capital of France?"
 },
 "expect": {
  "request": {
   "system": "Answer with sources.\n<answer>\n...\n</answer>\n",
   "messages": [
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "Capital of France?"
      }
     ]
    }
   ],
   "tools": [
    {
     "type": "builtin",
     "name": "web_search"
    }
   ]
  }
 }
}
