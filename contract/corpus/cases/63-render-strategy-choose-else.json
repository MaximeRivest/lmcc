{
 "name": "render-strategy-choose-else",
 "kind": "render",
 "entry": {
  "name": "choose_v1",
  "versions": {
   "kernel": "0.2.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nAnswer in exactly this form:\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "role": "user",
    "text": "{q}"
   }
  ],
  "parse": {
   "kind": "derived"
  },
  "strategies": {
   "reasoning": {
    "choose": [
     {
      "when": {
       "capability": "native_reasoning"
      },
      "use": {
       "requires": [
        "native_reasoning"
       ],
       "visible": false,
       "controls": {
        "reasoning": {
         "effort": "medium"
        }
       },
       "routings": [
        {
         "from": "channel:thinking",
         "to": "@role"
        }
       ]
      }
     },
     {
      "else": {
       "visible": false,
       "fragments": {
        "system": "Think inside <think>...</think> before you answer."
       },
       "routings": [
        {
         "from": "text",
         "between": [
          "<think>",
          "</think>"
         ],
         "to": "@role",
         "consume": true
        }
       ]
      }
     }
    ]
   }
  }
 },
 "signature": {
  "instructions": "Solve.",
  "fields": [
   {
    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "role": "reasoning"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "integer"
    }
   }
  ]
 },
 "inputs": {
  "q": "2+2?"
 },
 "expect": {
  "messages": [
   {
    "role": "system",
    "content": [
     {
      "kind": "text",
      "text": "Solve.\n\nAnswer in exactly this form:\n<answer>\n(integer)\n</answer>\n\n\nThink inside <think>...</think> before you answer."
     }
    ]
   },
   {
    "role": "user",
    "content": [
     {
      "kind": "text",
      "text": "2+2?"
     }
    ]
   }
  ],
  "patch": {}
 }
}
