{
 "name": "refuse-competing-formatted-turns",
 "kind": "refuse",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "tools_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "tools": {
    "use": "heredoc_tools"
   },
   "context": {
    "in_template": false,
    "put": {
     "@purpose": "message:system"
    },
    "spelling": {
     "result": "Other {output}"
    }
   }
  },
  "formats": {
   "list[Tool]": {
    "use": "function_tool"
   },
   "list[ToolCall]": {
    "use": "code_calls"
   }
  }
 },
 "signature": {
  "instructions": "Answer, using tools when needed.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "tools",
    "direction": "input",
    "type": "list[Tool]",
    "shape": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "purpose": "tools"
   },
   {
    "name": "calls",
    "direction": "output",
    "type": "list[ToolCall]",
    "shape": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "purpose": "tools.calls"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "context",
    "direction": "input",
    "shape": {
     "type": "string"
    },
    "purpose": "context"
   }
  ]
 },
 "capabilities": {
  "instruct": true
 },
 "expect": {
  "code": "entry-malformed",
  "fix": {
   "action": "edit-entry",
   "path": "transports['context'].spelling"
  },
  "at": "bind"
 }
}
