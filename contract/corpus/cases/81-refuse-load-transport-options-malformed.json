  "fields": [
   {
    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "purpose": "reasoning"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "expect": {
  "code": "entry-malformed",
  "fix": {
