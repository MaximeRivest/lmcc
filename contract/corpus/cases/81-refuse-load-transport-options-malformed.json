{
 "name": "refuse-load-transport-options-malformed",
 "kind": "refuse",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "empty_tags_v1",
  "versions": {
   "kernel": "0.7.0",
   "vocab": {
    "transport/reasoning_tags": "0.2.0"
   }
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nAnswer in exactly this form:\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "role": "user",
    "text": "{q}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
