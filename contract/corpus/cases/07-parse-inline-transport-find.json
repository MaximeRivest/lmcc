{
 "name": "parse-inline-transport-find",
 "kind": "parse",
 "entry": {
  "name": "sections_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nReply with EXACTLY these sections:\n{% for f in outputs %}<{f.name}>\n{f.value}\n{% endfor %}</done>"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{% for f in inputs %}== {f.name} ==\n{f.value}\n{% endfor %}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "reasoning": {
    "in_template": false,
    "tell": {
     "system": "Think inside <think>...</think> tags."
    },
    "find": [
     {
      "from": "text",
      "between": [
       "<think>",
       "</think>"
      ],
      "to": "@purpose",
      "remove": true
     }
    ]
   }
  }
 },
 "signature": {
  "instructions": "Answer.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "purpose": "reasoning"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "response": "<answer>\nParis<think>capital</think> indeed.\n</done>",
 "expect": {
  "values": {
   "answer": "Paris indeed.",
   "reasoning": "capital"
  }
 }
}
