{
 "name": "std-json-lens-format",
 "kind": "render",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "format_json_v1",
  "versions": {
   "kernel": "0.5.0",
   "vocab": {
    "lens/json_object": "0.1.0",
    "format/json": "0.1.0"
   }
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nAnswer like this:\n{format}"
   },
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "parse": {
   "kind": "json_object"
  },
  "formats": {
   "list[*]": {
    "use": "json"
   }
  }
 },
 "signature": {
  "instructions": "Answer.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "desc": "short answer"
   },
   {
    "name": "score",
    "direction": "output",
    "shape": {
     "type": "integer"
    }
   },
   {
    "name": "payload",
    "direction": "output",
    "shape": {
     "type": "array"
    }
   }
  ]
 },
 "capabilities": {
  "native_structured_output": true
 },
 "inputs": {
  "question": "capital of France?"
 },
 "expect": {
  "request": {
   "system": "Answer.\n\nAnswer like this:\n{\n  \"answer\": \"short answer\",\n  \"score\": \"(integer)\",\n  \"payload\": \"JSON matching this schema: {\\\"type\\\": \\\"array\\\"}\"\n}",
   "messages": [
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "capital of France?"
      }
     ]
    }
   ],
   "config": {
    "response_format": {
     "type": "json_schema",
     "schema": {
      "type": "object",
      "properties": {
       "answer": {
        "type": "string"
       },
       "score": {
        "type": "integer"
       },
       "payload": {
        "type": "array"
       }
      },
      "required": [
       "answer",
       "score",
       "payload"
      ],
      "additionalProperties": false
     }
    }
   }
  }
 }
}
