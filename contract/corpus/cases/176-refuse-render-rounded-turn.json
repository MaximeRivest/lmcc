{
 "name": "refuse-render-rounded-turn",
 "kind": "refuse",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "sections_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {
    "format/scaled_number": "0.2.0"
   }
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nReply with EXACTLY these sections:\n{% for f in outputs %}<{f.name}>\n{f.value}\n{% endfor %}</done>"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{% for f in inputs %}== {f.name} ==\n{f.value}\n{% endfor %}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "formats": {
   "number": {
    "use": "scaled_number",
    "options": {
     "scale": 100,
     "suffix": "%",
     "round": 0
    }
   }
  }
 },
 "signature": {
  "instructions": "x",
  "fields": [
   {
    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "confidence",
    "direction": "output",
    "shape": {
     "type": "number"
    }
   }
  ]
 },
 "expect": {
  "code": "turn-not-renderable",
  "at": "render"
 },
 "inputs": {
  "q": "now"
 },
 "turns": {
  "turns": [
   {
    "inputs": {
     "q": "then"
    },
    "steps": [],
    "outputs": {
     "confidence": 0.784
    }
   }
  ]
 }
}
