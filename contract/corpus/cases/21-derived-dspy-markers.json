{
 "name": "derived-dspy-markers",
 "kind": "render",
 "entry": {
  "name": "dspy_sections_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nReply with EXACTLY these sections:\n{% for f in outputs %}[[ ## {f.name} ## ]]\n{f.value}\n{% endfor %}[[ ## completed ## ]]"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{% for f in inputs %}== {f.name} ==\n{f.value}\n{% endfor %}"
   }
  ],
  "reader": {
   "kind": "derived"
  }
 },
 "signature": {
  "instructions": "Answer the question.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "desc": "short answer"
   },
   {
    "name": "score",
    "direction": "output",
    "shape": {
     "type": "integer"
    }
   }
  ]
 },
 "inputs": {
  "question": "3+3?"
 },
 "turns": {
  "turns": [
   {
    "inputs": {
     "question": "2+2?"
    },
    "outputs": {
     "answer": "4",
     "score": 10
    }
   }
  ]
 },
 "expect": {
  "request": {
   "system": "Answer the question.\n\nReply with EXACTLY these sections:\n[[ ## answer ## ]]\nshort answer\n[[ ## score ## ]]\n(integer)\n[[ ## completed ## ]]",
   "messages": [
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "== question ==\n2+2?\n"
      }
     ]
    },
    {
     "role": "assistant",
     "parts": [
      {
       "type": "text",
       "text": "[[ ## answer ## ]]\n4\n[[ ## score ## ]]\n10\n[[ ## completed ## ]]"
      }
     ]
    },
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "== question ==\n3+3?\n"
      }
     ]
    }
   ]
  }
 }
}
