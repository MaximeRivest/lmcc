{
 "name": "parse-repair-spacing",
 "kind": "parse",
 "entry": {
  "name": "repairs_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}[[ ## {f.name} ## ]]\n{f.value}\n\n{% endfor %}[[ ## completed ## ]]"
   },
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "reader": {
   "kind": "derived"
  }
 },
 "signature": {
  "instructions": "Answer the question.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "response": "[[## Answer ##]]\nParis\n\n[[## completed ##]]",
 "expect": {
  "values": {
   "answer": "Paris"
  },
  "repairs": [
   {
    "repair": "marker",
    "marker": "[[ ## answer ## ]]",
    "saw": "[[## Answer ##]]"
   },
   {
    "repair": "marker",
    "marker": "[[ ## completed ## ]]",
    "saw": "[[## completed ##]]"
   }
  ]
 }
}
