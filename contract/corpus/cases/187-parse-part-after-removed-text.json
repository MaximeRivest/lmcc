{
 "name": "parse-part-after-removed-text",
 "kind": "parse",
 "entry": {
  "name": "parts_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{q}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "reasoning": {
    "in_template": false,
    "find": [
     {
      "from": "text",
      "between": [
       "<think>",
       "</think>"
      ],
      "to": "@purpose",
      "remove": true
     }
    ]
   }
  }
 },
 "signature": {
  "instructions": "Illustrate.",
  "fields": [
   {
    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "purpose": "reasoning"
   },
   {
    "name": "caption",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "picture",
    "direction": "output",
    "shape": {
     "media": "image"
    }
   },
   {
    "name": "note",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "response": {
  "role": "assistant",
  "parts": [
   {
    "type": "text",
    "text": "<think>a long line of thought about cats</think>\n<caption>\nA cat\n</caption>\n<picture>\n"
   },
   {
    "type": "image",
    "source": {
     "type": "url",
     "url": "https://example.com/cat.png"
    }
   },
   {
    "type": "text",
    "text": "\n</picture>\n<note>\ndone\n</note>"
   }
  ]
 },
 "expect": {
  "values": {
   "caption": "A cat",
   "picture": {
    "source": {
     "type": "url",
     "url": "https://example.com/cat.png"
    }
   },
   "note": "done",
   "reasoning": "a long line of thought about cats"
  },
  "repairs": []
 }
}
