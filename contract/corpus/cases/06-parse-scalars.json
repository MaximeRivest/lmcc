{
 "name": "parse-scalars",
 "kind": "parse",
 "entry": {
  "name": "sections_v1",
  "versions": {
   "kernel": "0.2.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nReply with EXACTLY these sections:\n{% for f in outputs %}<{f.name}>\n{f.value}\n{% endfor %}</done>"
   },
   {
    "directive": "demos"
   },
   {
    "directive": "history"
   },
   {
