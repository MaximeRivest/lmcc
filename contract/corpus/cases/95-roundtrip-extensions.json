{
 "name": "roundtrip-extensions",
 "kind": "roundtrip",
 "requires": [
  "pattern/legacy-re2"
 ],
 "entry": {
  "name": "derived_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "extensions": {
   "pattern/legacy-re2": "0.1.0"
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nAnswer in exactly this form:\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "role": "user",
    "text": "{q}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "reasoning": {
    "in_template": false,
    "find": [
     {
      "from": "text",
      "pattern": "Thought: ([^\\n]+)",
      "to": "@purpose",
      "remove": true
     }
    ]
   }
  }
 },
 "expect": {
  "entry": {
   "name": "derived_v1",
   "versions": {
    "kernel": "0.8.2",
    "vocab": {}
   },
   "extensions": {
    "pattern/legacy-re2": "0.1.0"
   },
   "template": [
    {
     "role": "system",
     "text": "{instruction}\n\nAnswer in exactly this form:\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
    },
    {
     "role": "user",
     "text": "{q}"
    }
   ],
   "reader": {
    "kind": "derived"
   },
   "transports": {
    "reasoning": {
     "in_template": false,
     "find": [
      {
       "from": "text",
       "pattern": "Thought: ([^\\n]+)",
       "to": "@purpose",
       "remove": true
      }
     ]
    }
   }
  }
 }
}
