{
 "name": "render-prefill-replays-whole-recorded-reply",
 "kind": "render",
 "entry": {
  "name": "prefill_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{question}"
   },
   {
    "role": "assistant",
    "text": "<reasoning>\n"
   }
  ],
  "reader": {
   "kind": "derived"
  }
 },
 "signature": {
  "instructions": "Answer.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "integer"
    }
   }
  ]
 },
 "capabilities": {
  "assistant_prefill": true
 },
 "inputs": {
  "question": "6*7?"
 },
 "expect": {
  "request": {
   "system": "Answer.\n<reasoning>\n...\n</reasoning>\n<answer>\n(integer)\n</answer>\n",
   "messages": [
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "1?"
      }
     ]
    },
    {
     "role": "assistant",
     "parts": [
      {
       "type": "text",
       "text": "Sure.\n<reasoning>\nx\n</reasoning>\n<answer>\n1\n</answer>"
      }
     ]
    },
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "6*7?"
      }
     ]
    },
    {
     "role": "assistant",
     "parts": [
      {
       "type": "text",
       "text": "<reasoning>"
      }
     ]
    }
   ]
  }
 },
 "turns": {
  "turns": [
   {
    "inputs": {
     "question": "1?"
    },
    "steps": [
     {
      "kind": "model",
      "outputs": {
       "reasoning": "x",
       "answer": 1
      },
      "message": {
       "role": "assistant",
       "parts": [
        {
         "type": "text",
         "text": "Sure.\n<reasoning>\nx\n</reasoning>\n<answer>\n1\n</answer>"
        }
       ]
      }
     }
    ],
    "outputs": {
     "reasoning": "x",
     "answer": 1
    }
   }
  ]
 }
}
