{
 "name": "parse-inline-strategy-routing",
 "kind": "parse",
 "entry": {
  "name": "sections_v1",
  "versions": {
   "kernel": "0.1.0",
   "vocab": {}
  },
  "template": {
   "messages": [
    {
     "role": "system",
     "text": "{instruction}\n\nReply with EXACTLY these sections:\n{% for f in outputs %}<{f.name}>  {f.desc}\n{% endfor %}Close with </done>."
    },
    {
     "directive": "demos"
    },
    {
     "directive": "history"
    },
    {
     "role": "user",
     "text": "{% for f in inputs %}== {f.name} ==\n{f.value}\n{% endfor %}"
    }
   ]
  },
  "parse": {
   "kind": "sections",
   "open": "<{name}>",
   "tail": "</done>"
  },
  "requires": [],
  "strategies": {
   "reasoning": {
    "requires": [],
    "visible": false,
    "fragments": {
     "system": "Think inside <think>...</think> tags."
    },
    "routings": [
     {
      "extract": {
       "kind": "between",
       "open": "<think>",
       "close": "</think>"
      },
      "field": "@role",
      "join": "\n",
      "strip": true
     }
    ]
   }
  }
 },
 "signature": {
  "instructions": "Answer.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "role": "reasoning"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "response": "<answer>\nParis<think>capital</think> indeed.\n</done>",
 "expect": {
  "values": {
   "answer": "Paris indeed.",
   "reasoning": "capital"
  }
 }
}
