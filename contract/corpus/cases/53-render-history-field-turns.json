       "type": "text",
       "text": "== q ==\nsecond\n"
      }
     ]
    },
    {
     "role": "assistant",
     "parts": [
      {
       "type": "text",
       "text": "[[ ## a ## ]]\ntwo\n[[ ## completed ## ]]"
