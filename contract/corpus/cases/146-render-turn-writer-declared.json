{
 "name": "render-turn-writer-declared",
 "kind": "render",
 "requires": [
  "pattern/legacy-re2"
 ],
 "entry": {
  "name": "lp_v1",
  "versions": {
   "kernel": "0.7.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{q}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "reasoning": {
    "in_template": false,
    "find": [
     {
      "from": "text",
      "pattern": "Thought: ([^\\n]+)",
      "to": "@purpose",
      "remove": true
     }
    ],
    "spelling": {
     "value": "Thought: {value}",
     "position": "before"
    }
   }
  },
  "extensions": {
   "pattern/legacy-re2": "0.1.0"
  }
 },
 "signature": {
  "instructions": "Answer.",
  "fields": [
   {
    "name": "q",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "purpose": "reasoning"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "inputs": {
  "q": "And Italy?"
 },
 "turns": {
  "turns": [
   {
    "inputs": {
     "q": "Capital?"
    },
    "outputs": {
     "reasoning": "France.",
     "answer": "Paris"
    }
   }
  ]
 },
 "expect": {
  "request": {
   "system": "Answer.\n<answer>\n...\n</answer>\n",
   "messages": [
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "Capital?"
      }
     ]
    },
    {
     "role": "assistant",
     "parts": [
      {
       "type": "text",
       "text": "Thought: France.\n<answer>\nParis\n</answer>"
      }
     ]
    },
    {
     "role": "user",
     "parts": [
      {
       "type": "text",
       "text": "And Italy?"
      }
     ]
    }
   ]
  }
 }
}
