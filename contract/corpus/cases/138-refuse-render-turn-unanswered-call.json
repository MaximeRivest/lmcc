{
 "name": "refuse-render-turn-unanswered-call",
 "kind": "refuse",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "tools_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "tools": {
    "use": "fenced_tools"
   }
  },
  "formats": {
   "list[Tool]": {
    "use": "function_tool"
   },
   "list[ToolCall]": {
    "use": "tool_calls"
   }
  }
 },
 "signature": {
  "instructions": "Answer, using tools when needed.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "tools",
    "direction": "input",
    "type": "list[Tool]",
    "shape": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "purpose": "tools"
   },
   {
    "name": "calls",
    "direction": "output",
    "type": "list[ToolCall]",
    "shape": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "purpose": "tools.calls"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "capabilities": {
  "instruct": true
 },
 "inputs": {
  "question": "Weather in Paris?",
  "tools": [
   {
    "name": "get_weather",
    "description": "Weather for a city.",
    "parameters": {
     "type": "object",
     "properties": {
      "city": {
       "type": "string"
      }
     },
     "required": [
      "city"
     ]
    }
   }
  ]
 },
 "turns": {
  "turns": [
   {
    "inputs": {
     "question": "Weather in Paris?"
    },
    "steps": [
     {
      "kind": "model",
      "outputs": {
       "calls": [
        {
         "id": "call_1",
         "name": "get_weather",
         "input": {
          "city": "Paris"
         }
        }
       ]
      },
      "calls_field": "calls"
     }
    ]
   }
  ]
 },
 "expect": {
  "code": "turn-invalid",
  "at": "render"
 }
}
