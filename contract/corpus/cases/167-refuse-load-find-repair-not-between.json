{
 "name": "refuse-load-find-repair-not-between",
 "kind": "refuse",
 "entry": {
  "name": "repairs_v1",
  "versions": {
   "kernel": "0.8.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "reasoning": {
    "in_template": false,
    "find": [
     {
      "from": "part:thinking",
      "to": "@purpose",
      "repair": true
     }
    ]
   }
  }
 },
 "signature": {
  "instructions": "Answer the question.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "purpose": "reasoning"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "expect": {
  "code": "entry-malformed",
  "fix": {
   "action": "edit-entry",
   "path": "transports['reasoning'].find[0]"
  },
  "at": "load"
 }
}
