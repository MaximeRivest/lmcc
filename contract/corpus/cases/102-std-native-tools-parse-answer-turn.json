{
 "name": "std-native-tools-parse-answer-turn",
 "kind": "parse",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "tools_v1",
  "versions": {
   "kernel": "0.5.0",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "directive": "history"
   },
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "parse": {
   "kind": "derived"
  },
  "strategies": {
   "tools": {
    "use": "native_tools"
   }
  },
  "formats": {
   "list[Tool]": {
    "use": "function_tool"
   },
   "list[ToolCall]": {
    "use": "tool_calls"
   }
  }
 },
 "signature": {
  "instructions": "Answer, using tools when needed.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "tools",
    "direction": "input",
    "type": "list[Tool]",
    "shape": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "role": "tools"
   },
   {
    "name": "calls",
    "direction": "output",
    "type": "list[ToolCall]",
    "shape": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "role": "tools.calls"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "capabilities": {
  "native_function_calling": true
 },
 "response": {
  "role": "assistant",
  "parts": [
   {
    "type": "text",
    "text": "<answer>\nSunny.\n</answer>"
   }
  ]
 },
 "expect": {
  "values": {
   "calls": [],
   "answer": "Sunny."
  }
 }
}
