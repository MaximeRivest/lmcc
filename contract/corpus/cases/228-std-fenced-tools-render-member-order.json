{
 "name": "std-fenced-tools-render-member-order",
 "kind": "render",
 "ordered": true,
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "tools_order_v1",
  "versions": {
   "kernel": "0.8.4",
   "vocab": {}
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n{% for f in outputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{question}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "tools": {
    "use": "fenced_tools"
   }
  },
  "formats": {
