{
 "name": "refuse-bind-capability",
 "kind": "refuse",
 "vocab": [
  "std"
 ],
 "entry": {
  "name": "sections_v1",
  "versions": {
   "kernel": "0.7.0",
   "vocab": {
    "transport/native_reasoning": "0.1.0"
   }
  },
  "template": [
   {
    "role": "system",
    "text": "{instruction}\n\nReply with EXACTLY these sections:\n{% for f in outputs %}<{f.name}>\n{f.value}\n{% endfor %}</done>"
   },
   {
    "directive": "turns"
   },
   {
    "role": "user",
    "text": "{% for f in inputs %}== {f.name} ==\n{f.value}\n{% endfor %}"
   }
  ],
  "reader": {
   "kind": "derived"
  },
  "transports": {
   "reasoning": {
    "use": "native_reasoning"
   }
  }
 },
 "signature": {
  "instructions": "Answer.",
  "fields": [
   {
    "name": "question",
    "direction": "input",
    "shape": {
     "type": "string"
    }
   },
   {
    "name": "reasoning",
    "direction": "output",
    "shape": {
     "type": "string"
    },
    "purpose": "reasoning"
   },
   {
    "name": "answer",
    "direction": "output",
    "shape": {
     "type": "string"
    }
   }
  ]
 },
 "capabilities": {
  "instruct": true
 },
 "expect": {
  "code": "capability-missing",
  "fix": {
   "action": "declare-capability",
   "fact": "native_reasoning"
  },
  "at": "bind"
 }
}
