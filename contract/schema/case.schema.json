{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lmcc:schema:case:0.8.0",
  "title": "LMCC corpus case",
  "description": "One conformance case. The harness feeds these to any driver; the driver compares and answers {ok, detail}.",
  "type": "object",
  "required": [
    "name",
    "kind",
    "entry",
    "expect"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "render",
        "parse",
        "roundtrip",
        "refuse",
        "plan"
      ]
    },
    "vocab": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry": {
      "type": "object"
    },
    "signature": {
      "type": "object"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "inputs": {
      "type": "object"
    },
    "response": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "parts"
          ],
          "properties": {
            "role": {
              "type": "string"
            },
            "parts": {
              "type": "array"
            }
          },
          "description": "an lm15 message"
        },
        {
          "type": "object",
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "object",
              "required": [
                "parts"
              ]
            }
          },
          "description": "an lm15 response"
        }
      ]
    },
    "expect": {
      "type": "object"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(udf:[a-z]+|[a-z][a-z0-9_]*/[a-z][a-z0-9_-]*)$"
      },
      "description": "everything beyond the core the case needs: UDF placements (udf:<language>) and extensions (<family>/<name>); a driver binds exactly these, and one that lacks any answers unclaimed"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "urn:lmcc:schema:turn:0.8.0#/$defs/step"
      },
      "description": "the current turn's steps (kernel §3a)"
    },
    "turns": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "urn:lmcc:schema:turn:0.8.0"
        }
      },
      "description": "slot name → turns; a turn may omit signature, and the harness writes the case signature's fingerprint"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "render"
          }
        }
      },
      "then": {
        "required": [
          "signature"
        ],
        "properties": {
          "expect": {
            "required": [
              "request"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "parse"
          }
        }
      },
      "then": {
        "required": [
          "signature",
          "response"
        ],
        "properties": {
          "expect": {
            "required": [
              "values"
            ],
            "properties": {
              "repairs": {
                "type": "array",
                "description": "plan.read(response).repairs, in order (kernel §4a)",
                "items": {
                  "type": "object",
                  "required": [
                    "repair"
                  ],
                  "properties": {
                    "repair": {
                      "enum": [
                        "marker",
                        "unclosed",
                        "ignored",
                        "value"
                      ]
                    },
                    "marker": {
                      "type": "string"
                    },
                    "saw": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "close": {
                      "type": "string"
                    },
                    "as": {
                      "type": "string"
                    },
                    "part": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "roundtrip"
          }
        }
      },
      "then": {
        "properties": {
          "expect": {
            "required": [
              "entry"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "refuse"
          }
        }
      },
      "then": {
        "properties": {
          "expect": {
            "required": [
              "code",
              "at"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "fix": {
                "type": "object",
                "required": [
                  "action"
                ],
                "description": "the fix the refusal must carry, exactly (fix.schema.json); asserted when present"
              },
              "at": {
                "enum": [
                  "load",
                  "signature",
                  "bind",
                  "render",
                  "parse"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plan"
          }
        }
      },
      "then": {
        "required": [
          "signature"
        ],
        "properties": {
          "expect": {
            "required": [
              "skeleton",
              "prefix"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
