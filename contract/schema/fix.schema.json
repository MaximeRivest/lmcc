{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lmcc:schema:fix:0.6.0",
  "title": "LMCC refusal fix",
  "description": "The machine-actionable next step a refusal carries (spec/errors.md, Fix actions). Closed: one branch per action, exact parameter sets.",
  "type": "object",
  "required": ["action"],
  "oneOf": [
    {
      "properties": {
        "action": {"const": "install-vocabulary"},
        "kind": {"enum": ["format", "transport", "reader"]},
        "name": {"type": "string"}
      },
      "required": ["action", "kind", "name"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "match-version"},
        "entry": {"type": "string"},
        "needs": {"type": "string"},
        "provides": {"type": "string"}
      },
      "required": ["action", "entry", "needs", "provides"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "place-udf"},
        "language": {"type": "string"},
        "path": {"type": "string"}
      },
      "required": ["action", "language", "path"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "reship-udf"},
        "path": {"type": "string"}
      },
      "required": ["action", "path"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "edit-entry"},
        "path": {"type": "string"}
      },
      "required": ["action", "path"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "edit-template"},
        "path": {"type": "string"},
        "slot": {"type": "string"},
        "field": {"type": "string"}
      },
      "required": ["action", "path"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "edit-signature"},
        "field": {"type": "string"},
        "purpose": {"type": "string"}
      },
      "required": ["action"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "assign-purpose"},
        "purpose": {"type": "string"}
      },
      "required": ["action", "purpose"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "declare-capability"},
        "fact": {"type": "string"}
      },
      "required": ["action", "fact"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "satisfy-predicate"},
        "purpose": {"type": "string"},
        "predicate": {"type": "object"}
      },
      "required": ["action", "purpose", "predicate"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "bind-format"},
        "field": {"type": "string"},
        "key": {"type": "string"}
      },
      "required": ["action", "field", "key"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "declare-extension"},
        "family": {"type": "string"},
        "path": {"type": "string"}
      },
      "required": ["action", "family", "path"],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {"const": "bind-extension"},
        "name": {"type": "string"},
        "needs": {"type": "string"}
      },
      "required": ["action", "name", "needs"],
      "additionalProperties": false
    }
  ]
}
