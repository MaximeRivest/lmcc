{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a15.dev/schema/entry.schema.json",
  "title": "a15 adapter entry",
  "description": "The artifact: one adapter as plain data. Codec and strategy OPTION internals are owned by their vocabulary specs and deliberately left loose here.",
  "type": "object",
  "required": ["versions", "template", "parse"],
  "properties": {
    "name": { "type": "string" },
    "versions": {
      "type": "object",
      "required": ["kernel"],
      "properties": {
        "kernel": { "$ref": "#/$defs/semver" },
        "vocab": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/semver" }
        }
      }
    },
    "template": {
      "type": "object",
      "required": ["messages"],
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["role", "text"],
                "properties": {
                  "role": { "enum": ["system", "user", "assistant"] },
                  "text": { "type": "string" }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["directive"],
                "properties": { "directive": { "enum": ["demos", "history"] } },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "parse": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "sections" } } },
          "then": {
            "required": ["open"],
            "properties": {
              "open": { "type": "string", "pattern": ".*\\{name\\}.*" },
              "close": { "type": "string" },
              "tail": { "type": "string" }
            }
          }
        }
      ]
    },
    "strategies": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string" },
              "options": { "type": "object" }
            },
            "additionalProperties": false
          },
          { "$ref": "#/$defs/inline_strategy" }
        ]
      }
    },
    "codecs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string" },
          "options": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "requires": {
      "type": "array",
      "description": "Declared non-data requirements (authored code sidecars). Empty in kernel 0.1; the declaration mechanism is reserved.",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "inline_strategy": {
      "type": "object",
      "properties": {
        "requires": { "type": "array", "items": { "type": "string" } },
        "fragments": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "controls": { "type": "object" },
        "routings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["extract", "field"],
            "properties": {
              "extract": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["between", "pattern", "line_prefixed", "parts"] }
                }
              },
              "field": { "type": "string" },
              "join": { "type": "string" },
              "strip": { "type": "boolean" },
              "coerce": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "type": "string" },
                  "options": { "type": "object" }
                }
              }
            }
          }
        },
        "visible": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
