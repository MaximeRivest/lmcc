{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lmcc:schema:entry:0.2.0",
  "title": "LMCC adapter entry",
  "description": "The artifact (kernel.md §2, §5, §6): a template, a parse rule, strategies by role, formats by type — never a field name.",
  "type": "object",
  "required": [
    "versions",
    "template",
    "parse"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "versions": {
      "type": "object",
      "required": [
        "kernel"
      ],
      "properties": {
        "kernel": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "vocab": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        }
      }
    },
    "template": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "role",
              "text"
            ],
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "directive"
            ],
            "properties": {
              "directive": {
                "enum": [
                  "demos",
                  "history"
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "parse": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "strategies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/strategy"
      }
    },
    "formats": {
      "type": "object",
      "description": "keys: a type name as the frontend spells it, or a structural key (object, list[*], list[object], string, integer, number, boolean, enum, media:<kind>, media:*, *)",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/reference"
          },
          {
            "$ref": "#/$defs/shipped"
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "predicate": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "capability": {
          "type": "string"
        },
        "not": {
          "$ref": "#/$defs/predicate"
        },
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^(text|channel:[a-z_]+)$"
        },
        "between": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pattern": {
          "type": "string"
        },
        "line_prefixed": {
          "type": "string"
        },
        "to": {
          "type": "string",
          "pattern": "^@role(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
        },
        "consume": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "plain_strategy": {
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visible": {
          "type": "boolean"
        },
        "fragments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "controls": {
          "type": "object"
        },
        "placement": {
          "type": "object",
          "propertyNames": {
            "pattern": "^@role(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(controls\\.[A-Za-z_][A-Za-z0-9_.]*|message:(system|user|assistant))$"
          }
        },
        "routings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^(text|channel:[a-z_]+)$"
              },
              "between": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "pattern": {
                "type": "string"
              },
              "line_prefixed": {
                "type": "string"
              },
              "to": {
                "type": "string",
                "pattern": "^@role(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
              },
              "consume": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "strategy": {
      "oneOf": [
        {
          "$ref": "#/$defs/plain_strategy"
        },
        {
          "type": "object",
          "required": [
            "choose"
          ],
          "properties": {
            "choose": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "when",
                      "use"
                    ],
                    "properties": {
                      "when": {
                        "$ref": "#/$defs/predicate"
                      },
                      "use": {
                        "$ref": "#/$defs/strategy"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "else"
                    ],
                    "properties": {
                      "else": {
                        "$ref": "#/$defs/strategy"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/reference"
        }
      ]
    },
    "reference": {
      "type": "object",
      "required": [
        "use"
      ],
      "properties": {
        "use": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "shipped": {
      "type": "object",
      "required": [
        "language",
        "write",
        "sha256"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "deps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "string"
        },
        "read": {
          "type": "string"
        },
        "describe": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authored_by": {
          "type": "string"
        },
        "accepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emits": {
          "enum": [
            "text",
            "parts"
          ]
        },
        "round_trip": {
          "type": "boolean"
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
