{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lmcc:schema:entry:0.7.0",
  "title": "LMCC adapter entry",
  "description": "The artifact (kernel.md §2, §5, §6): a template, a reader, transports by purpose, formats by type — never a field name.",
  "type": "object",
  "required": [
    "versions",
    "template",
    "reader"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "versions": {
      "type": "object",
      "required": [
        "kernel"
      ],
      "properties": {
        "kernel": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "vocab": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "declared execution extensions (kernel §10): '<family>/<name>' -> the version this artifact needs; at most one per family",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*/[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/semver"
      }
    },
    "template": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "role",
              "text"
            ],
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "developer",
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "directive"
            ],
            "properties": {
              "directive": {
                "const": "turns"
              },
              "slot": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "not": {
                  "enum": [
                    "inputs",
                    "outputs",
                    "instruction",
                    "format"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "reader": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/transport"
      }
    },
    "formats": {
      "type": "object",
      "description": "keys: a type name as the frontend spells it, or a structural key (object, list[*], list[object], string, integer, number, boolean, enum, media:<kind>, media:*, *)",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/reference"
          },
          {
            "$ref": "#/$defs/shipped"
          }
        ]
      }
    },
    "replay": {
      "enum": [
        "recorded",
        "values"
      ],
      "description": "how a written model step is spelled (kernel §3a): the recorded reply when this plan reads it back into the same values (default), or always from values"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "predicate": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "capability": {
          "type": "string"
        },
        "not": {
          "$ref": "#/$defs/predicate"
        },
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        }
      },
      "additionalProperties": false
    },
    "find_rule": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^(text|part:[a-z_]+)$"
        },
        "between": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pattern": {
          "type": "string"
        },
        "line_prefixed": {
          "type": "string"
        },
        "to": {
          "type": "string",
          "pattern": "^@purpose(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
        },
        "remove": {
          "type": "boolean"
        },
        "complete_reply": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "plain_transport": {
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_template": {
          "type": "boolean"
        },
        "tell": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "request_settings": {
          "type": "object"
        },
        "put": {
          "type": "object",
          "propertyNames": {
            "pattern": "^@purpose(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(request\\.(config\\.[a-z_]+|tools)|message:(system|developer|user|assistant))$"
          }
        },
        "find": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^(text|part:[a-z_]+)$"
              },
              "between": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "pattern": {
                "type": "string"
              },
              "line_prefixed": {
                "type": "string"
              },
              "to": {
                "type": "string",
                "pattern": "^@purpose(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
              },
              "remove": {
                "type": "boolean"
              },
              "complete_reply": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "spelling": {
          "type": "object",
          "properties": {
            "call": {
              "type": "string"
            },
            "result": {
              "type": "string"
            },
            "input_format": {
              "$ref": "#/$defs/reference"
            },
            "probe": {
              "type": "object",
              "required": [
                "name",
                "input"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "position": {
              "enum": [
                "before",
                "after"
              ]
            }
          },
          "dependentRequired": {
            "input_format": [
              "call"
            ],
            "probe": [
              "call"
            ]
          },
          "additionalProperties": false
        },
        "written_as": {
          "type": "object",
          "propertyNames": {
            "pattern": "^@purpose(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "transport": {
      "oneOf": [
        {
          "$ref": "#/$defs/plain_transport"
        },
        {
          "type": "object",
          "required": [
            "choose"
          ],
          "properties": {
            "choose": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "when",
                      "use"
                    ],
                    "properties": {
                      "when": {
                        "$ref": "#/$defs/predicate"
                      },
                      "use": {
                        "$ref": "#/$defs/transport"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "else"
                    ],
                    "properties": {
                      "else": {
                        "$ref": "#/$defs/transport"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/reference"
        }
      ]
    },
    "reference": {
      "type": "object",
      "required": [
        "use"
      ],
      "properties": {
        "use": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "shipped": {
      "type": "object",
      "required": [
        "language",
        "write",
        "sha256"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "deps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "string"
        },
        "read": {
          "type": "string"
        },
        "describe": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authored_by": {
          "type": "string"
        },
        "accepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writes": {
          "enum": [
            "text",
            "parts"
          ]
        },
        "round_trip": {
          "type": "boolean"
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
