{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lmcc:schema:signature:0.2.0",
  "title": "LMCC signature (SignatureCore)",
  "description": "The frontend-neutral typed contract every language lowers to: instructions plus ordered fields. Uniqueness of field names is enforced by implementations (signature-malformed), not expressible here.",
  "type": "object",
  "required": [
    "instructions",
    "fields"
  ],
  "properties": {
    "instructions": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "direction",
        "shape"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "role": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "desc": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "the type's name as the frontend spells it; formats resolve by it first"
        }
      },
      "additionalProperties": false
    },
    "shape": {
      "description": "JSON Schema; the kernel interprets only type/enum/items/media and the two nullable spellings (kernel.md §1) and carries every other keyword untouched.",
      "type": "object",
      "properties": {
        "type": {
          "oneOf": [
            {
              "enum": [
                "string",
                "integer",
                "number",
                "boolean",
                "array",
                "object",
                "null"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "array",
                  "object",
                  "null"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "items": {
          "$ref": "#/$defs/shape"
        },
        "media": {
          "type": "string",
          "minLength": 1
        },
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          }
        }
      }
    }
  }
}
